# Build output — a burned disc and the CMake project mppcburner leaves behind
# while compiling one. Both are regenerated from what is tracked here.
/build/
.mppcburn/
*.mppcdisc
*.mppctex

# Memory-card images written by the console while this disc plays
*.mppccard

# Frame dumps (--dump-frame)
*.ppm

# Run logs
output.log
*.log

# Editor / IDE
.vscode/
.idea/
.cache/

# OS
.DS_Store
